Predecessor: é o valor que vem imediatamente antes de K quando os elementos estão ordenados

predecessor(r, k)
    se r == nulo
        retorne nulo


    noK = busca(k);
    se noK == nulo
        retorn nulo; //k não existe

    //noK é o no que contem k
    int cont = 0;
    chaveAux = noK.[0]
    while(noK[cont] != k){
        chaveAux = noK[cont]
        cont++;
    }
    //achei k
    if(chaveAux != k){
        //significa que o predecessor é o valor da extrema direita da sub arv [chaveAux, k](ou noK[cont]) ou chaveAux se não tievr sub Arv
        if(noK[cont].esq == nulo)
            retorne chaveAux;

        no = noK[cont];
        while(no.dir != nulo)
            no = no.dir

        retorne no[no.size - 1] //pego o ultimo valor da sub arv direita
    }


