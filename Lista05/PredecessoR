O algoritmo de predecessor em árvores B tem como objetivo encontrar a
maior chave da estrutura que seja menor do que uma chave k específica.

predecessor (r, k)

    se r == null
        retorne null //r não existe

    (noK, iK) = busca(r, k) //noK -> no que contem k, iK -> indice que k está no nó
    se nok == null
        return null //k não existe em r

    se (noK.filhos == null) //nok é uma folha
        se iK > 0
            retorne noK[iK - 1]
        senao
            //k não tem predecessor? não sei oq faço
            retorne null

    senao   //noK não é folha, então descesmos na sub arv direita de iK-1
        aux = noK.filhos[iK - 1]
        while aux.filhos != null
            aux = aux.filhos[aux.filhos.size()] //a ideia é pegar o ultimo ponteiro, não sei se assim é uma boa forma de escreve

        //estamos no ultimo no a extrema direita
        retorne aux[aux.filhos.size() - 1]     //menos 1 pois em arv B, filhos são sempre no max 2d + 1,
